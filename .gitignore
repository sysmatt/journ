# --- Local, repo-scoped dev toolchain (see scripts/setup-node.sh) ---------
# Self-contained Node runtime, downloaded per-repo instead of installed
# system-wide — the .venv equivalent for this project. Reproducible via
# the setup script, never committed.
/.node/

# --- Node / npm -------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# --- Frontend build tooling caches (NOT the build output itself — the
#     built PWA is intentionally committed; see docs/spec/operations.md) ---
.vite/

# --- PHP ----------------------------------------------------------------
vendor/

# --- Editors / OS cruft ---------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Local secrets / config (the real journ-config.ini lives OUTSIDE
#     this repo per the deployment model — see docs/spec/operations.md —
#     but ignore it here too in case a local copy is used for dev) --------
journ-config.ini
.env
